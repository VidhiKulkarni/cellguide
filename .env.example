# Copy to .env (gitignored) and fill in. Never commit real values.

# --- Agents 1, 2, 5 (Claude Agent SDK) ---
# platform.claude.com -> API keys
ANTHROPIC_API_KEY=

# --- Agent 1 (Paperclip MCP, X-API-Key auth) ---
# https://paperclip.gxl.ai/keys
PAPERCLIP_API_KEY=

# --- Agent 8 (Benchling sync) ---
# re:AGENT hackathon tenant. Note: NOT <org>.benchling.com, and NOT a Bearer API key.
# client_id/client_secret come from Developer Console -> Apps -> Create.
BENCHLING_TENANT_URL=https://hackathon26.bnchdev.org
BENCHLING_CLIENT_ID=
BENCHLING_CLIENT_SECRET=
# Folder ID for Hackathon26/AIFG
BENCHLING_AIFG_FOLDER_ID=
# Optional — narrows the query to a single custom-entity schema
BENCHLING_RESULTS_SCHEMA_ID=
